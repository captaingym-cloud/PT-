rules_version = '2';

// 트레이너 앱은 Firestore REST API를 SDK 없이 직접 호출하는 구조라, 문서 하나에
// 실제 데이터를 JSON 문자열(v 필드)로 통째로 저장하고, 그 옆에 ownerId(저장한
// 사람의 Firebase Auth UID) 필드를 같이 기록해서 "이 문서의 진짜 주인이 누구인지"
// 표시합니다. 이 규칙은 그 ownerId를 기준으로, 로그인한 사람이 자기 데이터만
// 만지도록 제한합니다.
//
// 단, ownerId 필드를 붙이기 시작한 게 오늘부터라 예전에 저장된 문서엔 이 필드가
// 없습니다. 예전 문서까지 갑자기 막히면 실제 트레이너들이 로그인 못 하는 사고로
// 이어지므로, ownerId가 아직 없는 문서는 "로그인만 하면" 접근을 허용하는 과도기
// 규칙을 같이 둡니다. 이후 예전 문서에도 ownerId를 채워 넣는 마이그레이션을
// 하고 나면, 과도기 허용 부분을 지우고 완전히 잠글 수 있습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    // 대표님(관리자) 전용 계정의 고정 UID. 대표님 대시보드는 모든 트레이너의
    // 데이터를 가로질러 봐야 하는데, ownerId가 제대로 채워진(=원래 의도대로
    // 다른 트레이너는 못 보게 잠긴) 문서는 대표님 계정도 남의 uid라 막혀버려서
    // "데이터가 있는데 없는 것처럼" 보이는 문제가 있었음. 그래서 이 UID만
    // ownerId 검사를 통과하도록 예외를 둠.
    function isAdmin() {
      return isLoggedIn() && request.auth.uid == 'NM93DCB0gUSxCM3NGy6SblPqj8j1';
    }

    function isOwnerOrLegacy() {
      return isLoggedIn() && (
        isAdmin() ||
        resource == null ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == '' ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // 기본값: 아무것도 명시적으로 허용 안 하면 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }

    // 트레이너 프로필
    match /trainers/{docId} {
      allow read, write: if isOwnerOrLegacy();
    }

    // 대표님 대시보드가 전체 트레이너 목록을 봐야 해서, 읽기는 로그인만 하면 허용.
    // 쓰기(자기 이름 등록)는 본인 것만.
    match /trainer_directory/{docId} {
      allow read: if isLoggedIn();
      allow write: if isOwnerOrLegacy();
    }

    // 전화번호/이메일로 로그인하려면 "이 번호가 어느 트레이너 계정인지"를 로그인
    // *하기 전에* 찾아야 하는데, 위 trainer_directory는 로그인 후에만 읽을 수 있어서
    // 이 조회에 못 씀. 그래서 이름/문서ID(tid)만 담은 최소한의 별도 컬렉션을 두고
    // 이것만 비로그인 상태에서도 읽기를 허용함 — 회원 데이터나 민감정보는 여기 안 담음.
    // 문서 ID 자체가 전화번호/이메일이라 쓰기는 "그 문서ID로 로그인된 사람 자신"만
    // 가능하도록 제한(다른 사람 전화번호로 매핑을 덮어쓰지 못하게).
    match /login_lookup/{docId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    // 대표님 마스터 PIN 등 — 트레이너 구분 없이 로그인만 하면 허용 (기존과 동일)
    match /admin/{docId} {
      allow read, write: if isLoggedIn();
    }

    // hist_/diet_/memo_/sent_/tone_ 등 회원별 데이터
    match /data/{docId} {
      allow read, write: if isOwnerOrLegacy();
    }

    // members_<트레이너ID> 처럼 트레이너마다 이름이 다른 회원 목록 컬렉션.
    // journal_/memo2_/inbody_/meal_ <트레이너ID>_<회원ID>는 일지/메모/인바디/
    // 식단 기록을 회원당 배열 문서 하나가 아니라 항목 하나당 문서 하나로
    // 저장하는 컬렉션 — 여러 기기에서 동시에 다른 항목을 써도 서로 다른
    // 문서라 덮어쓸 일이 없게 하기 위함(2026-07-08 데이터 유실 사고 이후
    // 배열 문서 구조에서 전환)
    match /{collection}/{docId} {
      allow read, write: if (
        collection.matches('^members_.*') ||
        collection.matches('^journal_.*') ||
        collection.matches('^memo2_.*') ||
        collection.matches('^inbody_.*') ||
        collection.matches('^meal_.*') ||
        collection.matches('^trash_.*')
      ) && isOwnerOrLegacy();
    }
  }
}
